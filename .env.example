# Copier ce fichier en .env et renseigner chaque variable.
# Utilisé par docker-compose.prod.yml

# ─── Tag de l'image Docker ────────────────────────────────────────────────────
# Laisser "latest" ou préciser un tag de release (ex: 1.2.0)
TAG=latest

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=chouine
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_DB=chouine
# Décommenter uniquement si la base est externe (ex : RDS, Supabase) :
# PGSSLMODE=require

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Générer avec : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=changeme_very_long_random_secret
JWT_EXPIRES_IN=7d

# ─── SMTP (contact@la-chouine.com) ────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=contact@la-chouine.com
SMTP_PASS=changeme_smtp_password
SMTP_FROM="La Chouine <contact@la-chouine.com>"

# ─── URLs ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=https://la-chouine.com

# ─── Connexion avec Google, Facebook ou Apple ─────────────────────────────────
# Un fournisseur dont les variables sont vides n'est pas proposé sur le site.
# Adresse publique du site, celle où arrivent les joueurs (la-chouine.com
# redirige vers www) : les adresses de retour en dépendent.
OAUTH_REDIRECT_BASE=https://www.la-chouine.com
# Google Cloud Console → API et services → Identifiants → ID client OAuth (Web).
# URI de redirection : https://www.la-chouine.com/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# developers.facebook.com → application « Consommateur » → Facebook Login.
# URI de redirection : https://www.la-chouine.com/api/auth/oauth/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# developer.apple.com (compte payant) → Services ID (APPLE_CLIENT_ID), Team ID,
# clé « Sign in with Apple » (.p8) : son ID et son contenu, retours à la ligne
# remplacés par \n, entre guillemets.
# URI de retour : https://www.la-chouine.com/api/auth/oauth/apple/callback
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Géolocalisation des visites (#311) : compte gratuit MaxMind GeoLite2
# (https://www.maxmind.com/en/geolite2/signup), puis « Manage License Keys ».
# Laissés vides, le service geoipupdate échoue et le backend garde DB-IP.
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
